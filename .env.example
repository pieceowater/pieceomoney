# From @BotFather.
BOT_TOKEN=

# Your numeric Telegram user id (not @username), e.g. from @userinfobot.
# Only this user's private chat is accepted; everything else is ignored.
OWNER_USER_ID=

# Used when a payload has no "currency". Limits and analytics use this currency.
DEFAULT_CURRENCY=KZT

# Timezone for displayed dates, day/week/month boundaries and zone-less dates.
TZ_NAME=Asia/Almaty

# Unusual-payment alerts: warn when a payment exceeds this multiple of your
# usual size (needs ~15 payments of history), and when one day reaches this
# many payments.
UNUSUAL_MULTIPLIER=3
DAILY_PAYMENTS_WARN=6

DB_PATH=data/money.db
